# AROLAGB Uptime — Always-on monitoring worker
# Deploy separately from the Next.js app (Railway / Render / Fly.io / Docker host)
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --omit=dev
COPY tsconfig.json ./
COPY src ./src
COPY worker ./worker
RUN npm install -g tsx
ENV NODE_ENV=production
CMD ["tsx", "worker/index.ts"]
